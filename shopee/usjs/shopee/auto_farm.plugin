// cron "55 * * * *" script-path=https://sdany.org/usjs/shopee/_shopee/crop/shopee_auto_harvest.js         , enabled=true, tag=🌱自動收成🪴
// cron "5,45 * * * *" script-path=https://sdany.org/usjs/shopee/_shopee/crop/shopee_auto_water.js         , enabled=false, tag=🌱自動澆水💦

