#!name=蝦皮 蝦蝦果園🌱 自動化
#!desc=v20261124 蝦蝦果園通知澆水
#!select=蝦蝦果園通知澆水,預設:否,是,自動
// #!select=蝦蝦果園站外澆水Link,預設:0,1,2,3
// #!select=蝦蝦果園站外澆水LinkTG,預設:是,否
// #!author=Sdany
// #!openUrl=https://sdany.org/usjs/shopee/auto_farm.plugin

[Argument]
eFriendHelp = switch,false,tag=幫朋友澆水
eFriendShakeTree = switch,false,tag=朋友搖樹
e1 = switch,false,tag=果園狀態
e2 = switch,false,tag=推薦商店
e3 = switch,false,tag=任務打卡
e4 = switch,false,tag=任務簽到獎勵
e5 = switch,false,tag=任務領取水滴
e6 = switch,false,tag=自動購買免費道具
e7 = switch,false,tag=自動使用道具
e8 = switch,false,tag=分享

[Script]
cron "5,30,50 * * * *" script-path = https://sdany.org/usjs/shopee/farm/farm_water.js                     , enabled={e1}, tag=🌱果園狀態 更新 收成 通知🥬
cron "5 0/5 * * *" script-path = https://sdany.org/usjs/shopee/farm/friend_help_v2.js                     , enabled={eFriendHelp}, tag=🌱自動幫朋友 澆水💦
cron "8 0/5 * * *" script-path = https://sdany.org/usjs/shopee/farm/friend_shake_tree.js                  , enabled={eFriendShakeTree}, tag=🌱朋友 搖樹💦
cron "7 0/4 * * *" script-path = https://sdany.org/usjs/shopee/farm/grocery_store_water.js                , enabled={e2}, tag=🌱推薦商店 領30💧x3
cron "10 0/4 * * *" script-path = https://sdany.org/usjs/shopee/farm/tasks_checkin.js                     , enabled={e3}, tag=🌱任務打卡 3次💧
cron "50 4,5,12 * * *" script-path = https://sdany.org/usjs/shopee/farm/tasks_signin_bundle.js            , enabled={e4}, tag=🌱任務簽到獎勵
cron "50 5-23/3 * * *" script-path = https://sdany.org/usjs/shopee/farm/tasks_mission_claim.js            , enabled={e5}, tag=🌱任務領取水滴💧
cron "19 0,4 * * *" script-path = https://sdany.org/usjs/shopee/farm/buy_free_item.js                     , enabled={e6}, tag=🌱自動購買免費道具🛠
cron "10 0 * * *" script-path = https://sdany.org/usjs/shopee/farm/prop_use_auto.js                       , enabled={e7}, tag=🌱自動使用道具🛠
cron "18 0,4 * * *" script-path = https://sdany.org/usjs/shopee/farm/share.js                             , enabled={e8}, tag=🌱分享 領10💧

// cron "5 6 * * *" script-path=https://sdany.org/usjs/shopee/farm/share_link.js                           , enabled=true, tag=🌱取得站外澆水💦Link🔗
