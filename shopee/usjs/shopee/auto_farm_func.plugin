[Script]
cron "36 0,1,12 * * *" script-path = https://sdany.org/usjs/shopee/farm/share.js                   , enabled=true, tag=分享 10 水滴
// cron "36 0,1,12 * * *" script-path = https://sdany.org/usjs/shopee/farm/claim_scenario_1001.js                   , enabled=true, tag=精品商家領水滴
cron "36 0,1,12 * * *" script-path = https://sdany.org/usjs/shopee/scripts1/shopee_tasks_live.js                   , enabled=true, tag=直播任務
cron "36 0,1,12 * * *" script-path = https://sdany.org/usjs/shopee/farm/played_mixmix.js                   , enabled=true, tag=玩過 合盒樂
cron "30 * * * *" script-path = https://sdany.org/usjs/shopee/farm/played_blockgame.js                       , enabled=true, tag=方塊爆爆
cron "30 * * * *" script-path = https://sdany.org/usjs/shopee/farm/played_battletops.js                       , enabled=true, tag=陀螺挑戰賽
cron "30 * * * *" script-path = https://sdany.org/usjs/shopee/scripts1/mkt_coins_task_claim_v3.js           , enabled=true, tag=🍤我的蝦幣💰領蝦幣任務v3
cron "30 0 * * *" script-path=https://sdany.org/usjs/shopee/farm/friend_shake_tree.js                                , enabled=false, tag=🌱好友搖樹測試
cron "30 0 * * *" script-path=https://sdany.org/usjs/shopee/farm/crop_list_filter.js                                , enabled=false, tag=🌱顯示 種子清單Ｆ
cron "5,25,45 * * * *" script-path=https://sdany.org/usjs/shopee/farm/farm_water_info.js                             , enabled=false, tag=🌱澆水通知 💦
cron "30 0 * * *" script-path=https://sdany.org/usjs/shopee/farm/friend_help_v2.js                                , enabled=false, tag=🌱好友澆水測試
cron "30 0 * * *" script-path=https://sdany.org/usjs/shopee/_shopee/crop/shopee_crop_info.js                 , enabled=false, tag=🌱查看 作物狀態
// http-response ^https:\/\/games\.shopee\.tw\/farm\/api\/friend\/orchard\/context\/get\?friendId=.+ script-path=https://sdany.org/usjs/shopee/farm/crop_info_friend.js,     requires-body=true, tag=🌱好友作物狀態 LOON Log, enabled=false

