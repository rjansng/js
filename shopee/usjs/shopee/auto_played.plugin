#!name=蝦皮 蝦蝦果園🌱 任務自動化
#!desc=v20261124 調整
//#!author=Sdany
//#!openUrl=https://sdany.org/usjs/shopee/auto_played.plugin


[Argument]
eAuto01 = switch,false,tag=瀏覽商店
eAuto02 = switch,false,tag=瀏覽商品
eAuto04 = switch,false,tag=方塊爆爆
eAuto05 = switch,false,tag=合盒樂
eAuto06 = switch,false,tag=泡泡王
eAuto07 = switch,false,tag=拼拼樂
eAuto08 = switch,false,tag=消消樂

[Script]
cron "12 4,9,12 * * *" script-path = https://sdany.org/usjs/shopee/farm/claim_browse.js                    , enabled={eAuto01} , tag=瀏覽 優選商店、贊助賣場 50
cron "13 4,12 * * *" script-path = https://sdany.org/usjs/shopee/farm/claim_sku.js                         , enabled={eAuto02} , tag=瀏覽 精選商品 15
cron "32 4,12 * * *" script-path = https://sdany.org/usjs/shopee/farm/played_mixmix.js                     , enabled={eAuto05} , tag=玩過 合盒樂
cron "34 4,12 * * *" script-path = https://sdany.org/usjs/shopee/farm/played_blockgame.js                  , enabled={eAuto04} , tag=玩過 方塊爆爆
cron "14 4,12 * * *" script-path = https://sdany.org/usjs/shopee/farm/tilematch_played.js                  , enabled={eAuto07} , tag=玩過 拼拼樂🎮
cron "15 4,12 * * *" script-path = https://sdany.org/usjs/shopee/farm/candycrush_played.js                 , enabled={eAuto08} , tag=玩過 消消樂🔶
cron "16 4-7,23 * * *" script-path = https://sdany.org/usjs/shopee/candycrush/share.js                     , enabled={eAuto08} , tag=分享 消消樂🔶 +1💎
cron "20 4,12 * * *" script-path = https://sdany.org/usjs/shopee/puzzle_bobble_be/reward.js                , enabled={eAuto06} , tag=登入 泡泡王🫧 領獎勵
cron "25 4,8,12 * * *" script-path = https://sdany.org/usjs/shopee/farm/auto_played.js                     , enabled={eAuto06} , tag=玩過 泡泡王

// cron "22 4,8,12 * * *" script-path = https://sdany.org/usjs/shopee/farm/puzzle-bobble-be_played_init.js  , enabled=true , tag=設定 自動玩過 泡泡王🫧 (扣次數)
